# Copy to .env.local and adjust for your deployment. All values are baked at build time
# by Vite (VITE_* prefix). For a runtime-configurable production build, serve a /config.json
# instead (see src/config.ts — env vars are the fallback).

# Directus REST base (items + assets + auth). No trailing slash.
VITE_DIRECTUS_URL=http://localhost:8055

# Signal-filter sidecar (FastAPI). No trailing slash.
VITE_FILTER_URL=http://localhost:8055/filter

# Potree octree static server. No trailing slash; the app appends /<octreePath>/.
VITE_OCTREE_URL=http://localhost:8055/octrees
