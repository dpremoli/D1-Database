# Production build — served by Caddy at https://<node>.<tailnet>.ts.net/app/ (same origin as
# Directus). Same-origin service URLs: empty Directus base = relative to the current origin, so
# /items,/assets,/auth hit Caddy's `reverse_proxy directus`; /filter + /octrees are Caddy handlers.
# Vite loads .env.production at HIGHER priority than .env.local, so these win for `npm run build`.
VITE_DIRECTUS_URL=
VITE_FILTER_URL=/filter
VITE_OCTREE_URL=/octrees
# Recording backend runs on the acquisition PC (host, needs the DAQ hardware). Caddy proxies it
# same-origin at /recorder → host.docker.internal:8200, so REST + the WS live stream reach it with no
# CORS and no HTTPS mixed-content block. (Only the rig with the hardware answers; tailnet-only.)
VITE_RECORDER_URL=/recorder
