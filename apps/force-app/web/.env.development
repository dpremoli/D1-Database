# Dev (npm run dev) — point the standalone app at the running D1 stack via the Caddy proxy (:80),
# which serves Directus (/items,/assets,/auth), the filter-service (/filter), and the octree files
# (/octrees) under one origin. Loaded only in development mode (.env.production is used for builds).
VITE_DIRECTUS_URL=http://localhost
VITE_FILTER_URL=http://localhost/filter
VITE_OCTREE_URL=http://localhost/octrees
VITE_RECORDER_URL=http://localhost:8200
