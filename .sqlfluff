[sqlfluff]
dialect = postgres
templater = raw
max_line_length = 100
# Disabled rules — the migration corpus predates sqlfluff enforcement.
# Rules will be re-enabled incrementally as the SQL is cleaned up.
#   LT01/LT02: false positives on adjacent-string-literal concatenation.
#   LT05: long INSERT data / COMMENT strings that can't be wrapped.
#   ST05: internal sqlfluff 3.2.4 IndexError crash.
#   CP02-CP05, AL01/AL03/AL05/AL08, LT08/LT09/LT11,
#   RF02/RF03, AM05, ST01/ST09: pre-existing legacy violations.
exclude_rules = LT01, LT02, LT05, LT08, LT09, LT11, ST01, ST05, ST09, CP02, CP03, CP04, CP05, AL01, AL03, AL05, AL08, AM05, RF02, RF03

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

# Views use short aliases; full qualification is too verbose.
[sqlfluff:rules:references.qualification]
force_enable = false
